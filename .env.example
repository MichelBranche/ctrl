# CTRL studio — environment reference.
#
# The public site builds and runs with NONE of these set: every integration
# degrades on its own (the API routes answer 503 "non configurato", the review
# strip is omitted, mail falls back to a mock, and so on). Copy this file to
# .env.local for development, and set the ones you need on Vercel for production.
#
# Legend:  [required for <feature>]  = that feature is off until it is set.
#          [optional]                = has a safe default or is simply skipped.

# ──────────────────────────────────────────────────────────────────────────
# Database — Turso / libSQL (lib/db.ts)
# Backs the admin dashboard, CRM, shop orders, email workflow, audit, backups.
# Without TURSO_DATABASE_URL, dbConfigured is false and every DB feature is off.
# TURSO_AUTH_TOKEN is required for a remote Turso URL; omit it for a local file.
# ──────────────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=          # [required for DB] e.g. libsql://name-org.turso.io  (or file:local.db)
TURSO_AUTH_TOKEN=            # [required for remote Turso]

# ──────────────────────────────────────────────────────────────────────────
# Admin authentication (lib/admin.ts)
# Signed-JWT sessions + scrypt password hashes. Everything fails closed:
# without SESSION_SECRET or a database, nobody can sign in.
# ADMIN_EMAIL + ADMIN_PASSWORD_HASH seed the 'founder' account on first run;
# after that the DB row is the source of truth (the env hash is seed-only).
# Hash format: scrypt$N$r$p$saltB64url$hashB64url
# ──────────────────────────────────────────────────────────────────────────
SESSION_SECRET=             # [required for admin login] long random string (e.g. openssl rand -base64 48)
ADMIN_EMAIL=                # [required to seed founder]
ADMIN_PASSWORD_HASH=        # [required to seed founder] scrypt$... (generated by the app's hashPassword)

# ──────────────────────────────────────────────────────────────────────────
# Daily cron (app/api/purge/route.ts, vercel.json → 03:17 UTC)
# Retention cleanup, audit trim, KPI snapshot, Discord flush, reviews sync,
# then the encrypted DB backup. Vercel sends "Authorization: Bearer $CRON_SECRET".
# Without it, /api/purge refuses to run.
# ──────────────────────────────────────────────────────────────────────────
CRON_SECRET=                # [required for the cron] random string, set the same value on Vercel Cron

# ──────────────────────────────────────────────────────────────────────────
# CRM ingest — "Radar" prospecting assistant (app/api/crm/ingest + iris-requests)
# Bearer token compared in constant time. Drafts are stored, never auto-sent.
# ──────────────────────────────────────────────────────────────────────────
CRM_INGEST_SECRET=          # [required for /api/crm ingest] bearer token the external assistant sends

# Outbound webhook the CRM calls to kick off an Iris search request (lib/crm-iris.ts).
CRM_IRIS_WEBHOOK_URL=       # [required for Iris requests]
CRM_IRIS_WEBHOOK_KEY=       # [optional] auth value sent on the webhook
CRM_IRIS_WEBHOOK_HEADER=    # [optional] header name for the key (defaults to a standard auth header)

# ──────────────────────────────────────────────────────────────────────────
# Discord notifications (lib/discord-notify.ts) — new leads, admin notices.
# Entirely optional; a missing webhook never blocks the cron or any action.
# ──────────────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=        # [optional] Discord channel webhook
DISCORD_BURST_MS=           # [optional] coalesce window in ms for bursts (has a default)

# ──────────────────────────────────────────────────────────────────────────
# Vercel Blob (app/(admin)/.../media) — admin media/cover uploads (capped 5MB).
# ──────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=      # [required for admin uploads] Vercel Blob read-write token

# ──────────────────────────────────────────────────────────────────────────
# Transactional email — Resend (app/(admin)/admin/meet-actions.ts)
# Used to send meeting / client emails. Separate from the agency inbox below.
# ──────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=             # [required for transactional mail]
MAIL_FROM=                  # [required for transactional mail] e.g. "CTRL <no-reply@ctrlagency.dev>"

# ──────────────────────────────────────────────────────────────────────────
# Agency inbox — IMAP/SMTP (lib/mail/*)
# A Gmail app password works (spaces are ignored). Credentials are read on the
# server only, never logged or sent to the browser.
# ──────────────────────────────────────────────────────────────────────────
AGENCY_IMAP_USER=           # [required for the inbox] mailbox address
AGENCY_IMAP_PASSWORD=       # [required for the inbox] app password
AGENCY_MAIL_FROM_NAME=      # [optional] display name on outgoing replies
# Local-only mock mailbox (ignored on Vercel production):
# AGENCY_MAIL_MOCK=1         # [optional] serve a fake inbox for local tests
# AGENCY_MAIL_MOCK_DELAY_MS= # [optional] simulated latency
# AGENCY_MAIL_MOCK_FAIL=     # [optional] force a failure path for testing

# ──────────────────────────────────────────────────────────────────────────
# Google OAuth — Google Meet links for client meetings (lib/google-meet.ts)
# ──────────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=     # [required for Meet]
GOOGLE_OAUTH_CLIENT_SECRET= # [required for Meet]
GOOGLE_OAUTH_REDIRECT_URI=  # [required for Meet] e.g. https://www.ctrlagency.dev/admin/google/callback

# ──────────────────────────────────────────────────────────────────────────
# Google Places (New) — home hero reviews (lib/google-reviews.ts)
# Place Details fields: rating, userRatingCount, reviews, googleMapsUri.
# Leave either one empty and the review strip is not rendered.
# The daily cron refreshes them at most once a day and keeps the last good row.
# ──────────────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=      # [optional] enables the reviews strip
GOOGLE_PLACE_ID=            # [optional] the Place ID only, e.g. ChIJ...
# GOOGLE_REVIEWS_FIXTURE=1   # [optional] local-only sample cards; ignored when NODE_ENV=production. Do not set on Vercel.

# ──────────────────────────────────────────────────────────────────────────
# Public site assistant (app/api/chat/route.ts)
# The public widget stays on the deterministic FAQ. These keys are not used.
# ──────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=             # [unused] public chat does not call a model
AI_GATEWAY_API_KEY=         # [unused] public chat does not call a model

# ──────────────────────────────────────────────────────────────────────────
# Admin CRM AI (app/api/admin/ai/*) — free providers only, server-side.
# Without a key the admin shows "AI non configurata" and the build still passes.
# Primary: Groq (OpenAI-compatible). On a 429 / daily token cap the lighter
# Groq model is tried, then Cloudflare Workers AI if both vars below are set.
# Contact text is sent only to whichever provider actually answers.
# AI_MOCK=1 returns fixture copy for local screenshots, including `next start`.
# It is ignored when VERCEL_ENV=production.
# ──────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=               # [required for admin AI] Groq API key
AI_MODEL=                   # [optional] default openai/gpt-oss-120b (tool calling)
AI_FALLBACK_MODEL=          # [optional] default openai/gpt-oss-20b, used after a Groq 429
AI_DAILY_LIMIT=             # [optional] requests per admin per Rome day, default 30
CLOUDFLARE_ACCOUNT_ID=      # [optional] Workers AI fallback
CLOUDFLARE_AI_TOKEN=        # [optional] Workers AI API token
CLOUDFLARE_AI_MODEL=        # [optional] default @cf/meta/llama-3.3-70b-instruct-fp8-fast
# AI_MOCK=1                 # [optional] local fixture answers. Ignored when VERCEL_ENV=production.

# ──────────────────────────────────────────────────────────────────────────
# DeepL translation (lib/translate.ts) — optional admin content translation.
# ──────────────────────────────────────────────────────────────────────────
DEEPL_API_KEY=              # [optional] DeepL API Free key

# ──────────────────────────────────────────────────────────────────────────
# IndexNow (app/api/indexnow-key/[key]/route.ts)
# Served at /<key>.txt for search-engine ping. Route 404s until this is set.
# ──────────────────────────────────────────────────────────────────────────
INDEXNOW_KEY=               # [optional] 8–128 hex characters

# ──────────────────────────────────────────────────────────────────────────
# Vercel API (lib/vercel.ts) — admin-side project calls.
# ──────────────────────────────────────────────────────────────────────────
VERCEL_API_TOKEN=           # [optional] Vercel API token
VERCEL_PROJECT_ID=          # [optional]
VERCEL_TEAM_ID=             # [optional] only for team-scoped projects

# ──────────────────────────────────────────────────────────────────────────
# Business details — structured-data / SEO overrides (lib/seo.ts)
# All optional: each falls back to the hard-coded studio values in lib/content.ts.
# ──────────────────────────────────────────────────────────────────────────
BUSINESS_LEGAL_NAME=        # [optional] if it differs from CTRL®
BUSINESS_PHONE=             # [optional]
BUSINESS_STREET_ADDRESS=    # [optional]
BUSINESS_POSTAL_CODE=       # [optional]

# ──────────────────────────────────────────────────────────────────────────
# Development fixtures
# ──────────────────────────────────────────────────────────────────────────
# JOURNAL_FIXTURES=1         # [optional] sample journal entries for local layout checks
