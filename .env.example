# Google Places API (New), home hero reviews.
# Place Details fields: rating, userRatingCount, reviews, googleMapsUri.
# Leave either one empty and the strip is not rendered.
# Place Details returns at most five reviews. The daily cron refreshes them once a day.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Local layout check only. Shows sample cards marked as a preview.
# Ignored when NODE_ENV is production. Do not set this on Vercel.
# GOOGLE_REVIEWS_FIXTURE=1
